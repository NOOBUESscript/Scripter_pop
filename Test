local function CreateButton(parent, x, y, width, label, callback, scale)
    scale = scale or 1
    local btn = Make("TextButton", {
        Size = UDim2.new(0, width, 0, 24 * scale),
        Position = UDim2.new(0, x, 0, y),
        BackgroundColor3 = Config.Accent,
        BorderSizePixel = 0,
        Text = label, TextColor3 = Config.Text,
        TextSize = 11 * scale,
        Font = Enum.Font.SourceSansBold,
        AutoButtonColor = false,
        Parent = parent
    })
    AddCorner(btn, 4)
    if callback then btn.MouseButton1Click:Connect(callback) end
end

local function CreateInput(parent, x, y, width, label, key, placeholder, scale)
    scale = scale or 1
    Make("TextLabel", {
        Size = UDim2.new(0, width, 0, 14 * scale),
        Position = UDim2.new(0, x, 0, y),
        BackgroundTransparency = 1,
        Text = label, TextColor3 = Config.TextDim,
        TextSize = 11 * scale,
        Font = Enum.Font.SourceSans,
        TextXAlignment = Enum.TextXAlignment.Left,
        Parent = parent
    })
    
    local box = Make("TextBox", {
        Size = UDim2.new(0, width, 0, 24 * scale),
        Position = UDim2.new(0, x, 0, y + 16 * scale),
        BackgroundColor3 = Config.Input,
        BorderSizePixel = 1,
        BorderColor3 = Config.CardBorder,
        Text = "",
        PlaceholderText = placeholder or "",
        PlaceholderColor3 = Config.TextMuted,
        TextColor3 = Config.Text,
        TextSize = 11 * scale,
        Font = Enum.Font.SourceSans,
        ClearTextOnFocus = false,
        Parent = parent
    })
    AddCorner(box, 4)
    AddPadding(box, 0, 0, 6 * scale, 6 * scale)
    
    inputValues[key] = ""
    box.FocusLost:Connect(function() inputValues[key] = box.Text end)
end

local function CreateCard(parent, y, title, height, opts)
    opts = opts or {}
    local card = Make("Frame", {
        Size = UDim2.new(1, 0, 0, height or 100),
