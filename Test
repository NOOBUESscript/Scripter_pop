-- ==================== ERROR HANDLING ====================
local LOG_PREFIX = "[" .. Config.Title .. "]"
local LOG_THROTTLE = 5
local lastLogged = {}

local function LogError(context, err)
    local message = LOG_PREFIX .. " " .. context .. ": " .. tostring(err)
    local now = os.clock()
    local previous = lastLogged[message]
    if previous and now - previous < LOG_THROTTLE then return end
    lastLogged[message] = now
    warn(message)
end

-- Runs fn, logging (instead of discarding) any error. Returns ok, result/err.
local function Try(context, fn, ...)
    local results = table.pack(pcall(fn, ...))
    if not results[1] then
        LogError(context, results[2])
        return false, results[2]
    end
    return true, table.unpack(results, 2, results.n)
end

-- Wraps an event callback so a failure is logged instead of vanishing.
local function Protect(context, fn)
    return function(...)
        local results = table.pack(Try(context, fn, ...))
        if not results[1] then return end
        return table.unpack(results, 2, results.n)
    end
end

-- Background loop whose body cannot kill the thread: errors are logged and
-- the loop keeps running.
local function SpawnLoop(context, interval, body)
    task.spawn(function()
        while true do
            Try(context, body)
            if interval then wait(interval) else wait() end
        end
    end)
end

-- ==================== UTILITIES ====================
local function Make(class, props)
    local inst = Instance.new(class)
    for k, v in pairs(props) do inst[k] = v end
    return inst
end

local function AddCorner(parent, radius)
    local c = Instance.new("UICorner")
    c.CornerRadius = UDim.new(0, radius or 8)
    c.Parent = parent
    return c
end

local function AddPadding(parent, t, b, l, r)
    local p = Instance.new("UIPadding")
    p.PaddingTop = UDim.new(0, t or 0)
    p.PaddingBottom = UDim.new(0, b or 0)
    p.PaddingLeft = UDim.new(0, l or 0)
    p.PaddingRight = UDim.new(0, r or 0)
    p.Parent = parent
    return p
end

local function Tween(obj, props, duration)
    local info = TweenInfo.new(duration or 0.3, Enum.EasingStyle.Quart, Enum.EasingDirection.Out)
    local t = TweenService:Create(obj, info, props)
    t:Play()
    return t
end

local Notify

-- Returns true when the text reached the clipboard, false plus a reason otherwise.
local function CopyToClipboard(text)
    local clipboard = setclipboard or toclipboard
    if not clipboard then
        LogError("CopyToClipboard", "executor exposes no clipboard function")
        return false, "Clipboard not supported by your executor"
    end
    local ok, err = Try("CopyToClipboard", clipboard, text)
    if not ok then return false, tostring(err) end
    return true
end

local function Shake(gui)
    for i = 1, 4 do
        Tween(gui, {Position = UDim2.new(gui.Position.X.Scale, gui.Position.X.Offset + 6, gui.Position.Y.Scale, gui.Position.Y.Offset)}, 0.04)
        wait(0.04)
        Tween(gui, {Position = UDim2.new(gui.Position.X.Scale, gui.Position.X.Offset - 6, gui.Position.Y.Scale, gui.Position.Y.Offset)}, 0.04)
        wait(0.04)
    end
end

local function LoadImage(parent, imageId, size, fallback)
    local loaded = false
    if imageId and imageId ~= "" then
        loaded = Try("LoadImage(" .. tostring(imageId) .. ")", function()
            Make("ImageLabel", {
                Size = size,
                BackgroundTransparency = 1,
                Image = imageId,
                ScaleType = Enum.ScaleType.Fit,
                Parent = parent
            })
        end)
    end
    if not loaded then
        Make("TextLabel", {
            Size = size,
            BackgroundTransparency = 1,
            Text = fallback or "?",
            TextColor3 = Config.Text,
            TextSize = 16,
            Font = Enum.Font.GothamBold,
            Parent = parent
        })
    end
end

-- Surfaces a failure (or confirmation) to the player, not only to the console.
function Notify(text, isError)
    if isError then LogError("Notify", text) end
    local ok = pcall(function()
        local gui = Make("ScreenGui", {
            Name = "SilentNotify",
            ResetOnSpawn = false,
            IgnoreGuiInset = true,
            DisplayOrder = 1000,
            Parent = player.PlayerGui
        })
        local label = Make("TextLabel", {
            Size = UDim2.new(0, math.min(viewport.X * 0.8, 320), 0, 32),
            Position = UDim2.new(0.5, 0, 0, 12),
            AnchorPoint = Vector2.new(0.5, 0),
            BackgroundColor3 = Config.Card,
            BackgroundTransparency = 0.1,
            BorderSizePixel = 1,
            BorderColor3 = isError and Config.Error or Config.Success,
            Text = text,
            TextColor3 = isError and Config.Error or Config.Success,
            TextSize = 12,
            TextWrapped = true,
            Font = Enum.Font.GothamBold,
            Parent = gui
        })
        AddCorner(label, 8)
        task.delay(3, function() gui:Destroy() end)
    end)
    if not ok then
        warn(LOG_PREFIX .. " " .. tostring(text))
    end
end

local function Fire(remote, ...)
    if typeof(remote) ~= "Instance" then
        LogError("Fire", "remote is missing (got " .. typeof(remote) .. ")")
        return false
    end
    return (Try("Fire(" .. remote.Name .. ")", function(...) remote:FireServer(...) end, ...))
end

