-- ==================== KEY SYSTEM ====================

local function ListHasKey(list, key)
    for _, k in ipairs(list) do
        if k:upper() == key then return true end
    end
    return false
end

local KeyFailures = {
    expired = {"⏰  EXPIRED", Config.Warning, "⏰ Key expired!"},
    banned = {"🚫  BANNED", Config.Error, "🚫 Key banned!"},
    invalid = {"✗  INVALID", Config.Error, "✗ Invalid key!"}
}

local function CheckKeyStatus(key)
    key = key:upper()
    if ListHasKey(Config.ActiveKeys, key) then return "active" end
    if ListHasKey(Config.ExpiredKeys, key) then return "expired" end
    if ListHasKey(Config.BannedKeys, key) then return "banned" end
    return "invalid"
end

